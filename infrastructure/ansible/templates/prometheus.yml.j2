global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

rule_files:
  - "/etc/prometheus/alerts.yml"

scrape_configs:
  - job_name: 'node_exporter'
    static_configs:
      - targets: ['16.79.152.201:9100']
        labels:
          instance: 'Gateway'
      - targets: ['108.137.128.226:9100']
        labels:
          instance: 'Appserver 1'
      - targets: ['108.137.104.154:9100']
        labels:
          instance: 'Appserver 2'
      - targets: ['15.232.78.179:9100']
        labels:
          instance: 'Appserver 3'

  - job_name: 'cadvisor'
    static_configs:
      - targets: ['108.137.128.226:8080']
        labels:
          instance: 'Appserver 1'

  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          instance: 'Prometheus'
